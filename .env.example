# ---------------------------------------------------------------------------
# Recess (SIS-Group-25) — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real keys.
# See docs/backend/environment-setup.md for full setup instructions.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API in the Supabase dashboard)
# Safe to expose to the browser: URL + anon/public key only.
# NEVER put the service_role key in a VITE_ variable — it must stay
# server-side (Supabase Edge Function secrets), or it will ship to every
# client and bypass Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Map provider (decision pending — Phase 0 "Select map provider" task)
# Uncomment and set once a provider is chosen.
# VITE_MAPBOX_TOKEN=your-mapbox-public-token
